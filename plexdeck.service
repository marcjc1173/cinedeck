[Unit]
Description=PlexDeck Dashboard Service
After=network.target

[Service]
Type=simple
User=mcohen
WorkingDirectory=/home/mcohen/projects/coolplex
ExecStart=/home/mcohen/.nvm/versions/node/v22.22.2/bin/node server.js
Restart=on-failure
Environment=NODE_ENV=production PORT=3030

[Install]
WantedBy=multi-user.target
